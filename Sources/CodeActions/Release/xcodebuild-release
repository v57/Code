#!/bin/zsh
# xcodebuild for a Mac release archive, linked as the v57 apps ship: the arguments as given, plus
#   - Swift LTO with -internalize-at-link and -conditional-runtime-records,
#   - ld-archive-prelink (beside this script) as the linker: Xcode's per-package `ld -r` pre-links become static
#     archives, so the final link drops unused package code, and that link runs LLVM's machine outliner and drops the
#     Swift code only Swift's own metadata records kept,
#   - actool-icon-slim (beside this script) as the asset catalog compiler: an Icon Composer icon's flattened
#     fallbacks are stored as HEVC instead of lossless (Assets.car 1.7 MB -> 140 KB),
#   - for an archive (-archivePath): release-languages (beside this script) on its app, which copies the bundled
#     languages from v57/Localizations, writes a stub .lproj per downloadable one, CFBundleLocalizations and
#     V57Languages, and re-signs the app (LANGUAGE_SOURCES / LANGUAGES_BUNDLED and the pinned v57/Localizations
#     commit LOCALIZATIONS_REF in the project's release.env, V57_LANGUAGE_SOURCES / V57_LANGUAGES_BUNDLED /
#     V57_LOCALIZATIONS_REF, V57_LOCALIZATIONS_URL: see that script).
# Apps are 35-50% smaller and run the same instructions. CodeActions' Install and Export, Dev's release.sh and the
# apps' release scripts all archive through this script, so this folder is the one copy of these tools.
#
#   Usage: xcodebuild-release <xcodebuild arguments>     e.g. xcodebuild-release -project App.xcodeproj -scheme App archive
#   RELEASE_TOOLS_WORK   where the actool copy goes (default: $TMPDIR/xcodebuild-release-<uid>; without TMPDIR a
#                        new private folder from mktemp, removed afterwards)
here=${0:A:h}

# Xcode reads a tool's version under its file name (com.apple.actool.version), so the copy is named actool, and it
# builds its helper beside itself, so it goes in a folder of ours (this one may be inside a signed app). Never a
# fixed name in the shared /tmp: another user could make that folder first and put their own actool in it (security
# audit L12). macOS's TMPDIR is the user's own folder.
if [[ -n $RELEASE_TOOLS_WORK ]]; then
  work=$RELEASE_TOOLS_WORK
elif [[ -n $TMPDIR ]]; then
  work=${TMPDIR%/}/xcodebuild-release-$UID
else
  work=$(mktemp -d -t xcodebuild-release) || exit
  trap 'rm -rf $work' EXIT
fi
mkdir -p $work/icon-slim && install -C -m 755 $here/actool-icon-slim $work/icon-slim/actool || exit

xcodebuild "$@" SWIFT_LTO=YES ALTERNATE_LINKER_PATH=$here/ld-archive-prelink \
  ASSETCATALOG_EXEC=$work/icon-slim/actool \
  'OTHER_SWIFT_FLAGS=$(inherited) -Xfrontend -internalize-at-link -Xfrontend -conditional-runtime-records' || exit

# An archive's app gets its translations. The project's folder (release.env) is the -project/-workspace one, else here.
(( ${@[(Ie)archive]} )) || exit 0
archive= project=$PWD
for (( i = 1; i < $#; i++ )); do
  case ${@[i]} in
  -archivePath) archive=${@[i+1]} ;;
  -project|-workspace) project=${${@[i+1]}:a:h} ;;
  esac
done
[[ -n $archive ]] || { echo "xcodebuild-release: no -archivePath, so the archive's languages are left as built" >&2; exit 0 }
$here/release-languages --project-dir $project ${archive:a}
