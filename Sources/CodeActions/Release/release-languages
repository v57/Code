#!/usr/bin/env -S python3 -I
"""Puts an app's translations from v57/Localizations into its built bundle (Ideas/Localization.md, "Shape" 3):

  - the bundled languages' tables, every source's merged into the app's own <lang>.lproj (the app's own lines first,
    then its sources in order: the app's, then its kits'), compiled to binary plists as Xcode does, every line checked
    against its key's format specifiers;
  - a stub <lang>.lproj (InfoPlist.strings only) for every other language the sources have, so the system and the App
    Store see it;
  - Info.plist: CFBundleLocalizations lists every language, V57Languages maps each downloadable one to its size (the
    bytes PlatformLanguages downloads for it across the app's sources);
  - the app re-signed as it was signed (identity, entitlements, flags, hardened runtime).

xcodebuild-release runs it on an archive's app. By hand:

  release-languages [--sources 'Markdown ComponentKit'] [--bundled 'de fr'] [--project-dir DIR] APP_OR_XCARCHIVE

The sources are the list the app passes to KitLanguages.start(sources:). They and the bundled languages come from
--sources / --bundled, else $V57_LANGUAGE_SOURCES / $V57_LANGUAGES_BUNDLED, else LANGUAGE_SOURCES / LANGUAGES_BUNDLED
in the project's release.env. No sources: nothing to do. Bundled default: de fr es ja zh-Hans pt-BR ko it ru.

v57/Localizations comes from $V57_LOCALIZATIONS_URL (a folder or an http(s) URL), else the checkout beside the
project's repository or beside Code's (../Localizations), else GitHub (raw.githubusercontent.com/v57/Localizations/main).
"""
import argparse
import hashlib
import json
import os
import plistlib
import re
import shlex
import subprocess
import sys
import tempfile
import urllib.request

DEFAULT_BUNDLED = "de fr es ja zh-Hans pt-BR ko it ru"
GITHUB = "https://raw.githubusercontent.com/v57/Localizations/main/"
HERE = os.path.dirname(os.path.realpath(__file__))


def log(message):
    print(f"release-languages: {message}", file=sys.stderr)


def fail(message):
    log(f"error: {message}")
    sys.exit(1)


# MARK: - Configuration


def release_env(project_dir):
    """KEY=value lines of release.env, read without running it."""
    path = os.path.join(project_dir, "release.env")
    values = {}
    if not os.path.isfile(path):
        return values
    with open(path, encoding="utf-8") as handle:
        for line in handle:
            match = re.match(r"\s*(?:export\s+)?([A-Za-z_][A-Za-z0-9_]*)=(.*)$", line)
            if not match:
                continue
            try:
                words = shlex.split(match.group(2), comments=True)
            except ValueError:
                continue
            values[match.group(1)] = " ".join(words)
    return values


def git_main_checkout(directory):
    try:
        common = subprocess.run(
            ["git", "-C", directory, "rev-parse", "--path-format=absolute", "--git-common-dir"],
            capture_output=True, text=True, check=True).stdout.strip()
    except (subprocess.CalledProcessError, FileNotFoundError):
        return None
    return os.path.dirname(common)


# MARK: - v57/Localizations


class Localizations:
    """Reads files from a folder or over HTTP."""

    def __init__(self, location):
        self.location = location
        self.remote = location.startswith(("http://", "https://"))
        if self.remote and not location.endswith("/"):
            self.location += "/"

    def read(self, path):
        if self.remote:
            with urllib.request.urlopen(self.location + path, timeout=60) as response:
                return response.read()
        with open(os.path.join(self.location, path), "rb") as handle:
            return handle.read()

    def describe(self):
        if self.remote:
            return self.location
        head = subprocess.run(["git", "-C", self.location, "rev-parse", "--short", "HEAD"],
                              capture_output=True, text=True).stdout.strip()
        dirty = subprocess.run(["git", "-C", self.location, "status", "--porcelain", "--", "."],
                               capture_output=True, text=True).stdout.strip()
        if not head:
            return self.location
        return f"{self.location} at {head}{' with uncommitted changes' if dirty else ''}"


def find_localizations(project_dir):
    explicit = os.environ.get("V57_LOCALIZATIONS_URL")
    if explicit:
        if explicit.startswith("file://"):
            explicit = urllib.request.url2pathname(explicit[len("file://"):])
        return Localizations(explicit)
    candidates = []
    main = git_main_checkout(project_dir)
    if main:
        candidates.append(os.path.join(main, "..", "Localizations"))
    # This script in Code's checkout: Code/Sources/CodeActions/Release.
    candidates.append(os.path.join(HERE, "..", "..", "..", "..", "Localizations"))
    for candidate in candidates:
        if os.path.isfile(os.path.join(candidate, "manifest.json")):
            return Localizations(os.path.realpath(candidate))
    return Localizations(GITHUB)


# MARK: - Format check (PlatformLanguages' FormatCheck: bundled lines aren't checked at run time)


def specifiers(text):
    """(position or None, kind) for each argument `text` reads; None when one is never safe (%n)."""
    result = []
    index, count = 0, len(text)

    def digits():
        nonlocal index
        value = None
        while index < count and text[index] in "0123456789":
            value = (value or 0) * 10 + int(text[index])
            index += 1
        return value

    while index < count:
        if text[index] != "%":
            index += 1
            continue
        start = index
        index += 1
        if index >= count:
            break
        if text[index] == "%":
            index += 1
            continue
        position = None
        mark = index
        number = digits()
        if number is not None and index < count and text[index] == "$":
            position = number
            index += 1
        else:
            index = mark
        if index < count and text[index] == "#":
            # %#@name@: a stringsdict variable.
            while index < count and text[index] != "@":
                index += 1
            index += 1
            while index < count and text[index] != "@":
                index += 1
            index += 1
            continue
        while index < count and text[index] in "-+ #0'":
            index += 1
        if index < count and text[index] == "*":
            result.append((None, "int32"))
            index += 1
        else:
            digits()
        if index < count and text[index] == ".":
            index += 1
            if index < count and text[index] == "*":
                result.append((None, "int32"))
                index += 1
            else:
                digits()
        length = ""
        while index < count and text[index] in "hlqLztj":
            length += text[index]
            index += 1
        if index >= count:
            break
        conversion = text[index]
        index += 1
        wide = length in ("l", "ll", "q", "z", "t", "j")
        if conversion == "@":
            result.append((position, "object"))
        elif conversion in "diuxXo":
            result.append((position, "int64" if wide else "int32"))
        elif conversion in "DUO":
            result.append((position, "int64"))
        elif conversion in "cC":
            result.append((position, "int32"))
        elif conversion in "fFeEgGaA":
            result.append((position, "longDouble" if length == "L" else "double"))
        elif conversion in "sS":
            result.append((position, "cString"))
        elif conversion == "p":
            result.append((position, "pointer"))
        elif conversion == "n":
            return None
        else:
            index = start + 1
    return result


def arguments(found):
    result, following = {}, 1
    for position, kind in found:
        number = position if position is not None else following
        if position is None:
            following += 1
        if result.get(number, kind) != kind:
            return None
        result[number] = kind
    return result


DANGEROUS = {"object", "cString", "pointer"}


def fits(translation, key):
    theirs = specifiers(translation)
    their_arguments = arguments(theirs) if theirs is not None else None
    if their_arguments is None:
        return False
    ours = specifiers(key)
    key_arguments = arguments(ours) if ours is not None else None
    if key_arguments is None:
        return translation == key
    if not key_arguments:
        return not any(kind in DANGEROUS for kind in their_arguments.values())
    return all(key_arguments.get(number) == kind for number, kind in their_arguments.items())


def fits_plural(entry, key):
    if not isinstance(entry, dict) or not isinstance(entry.get("NSStringLocalizedFormatKey"), str):
        return False
    ours = specifiers(key)
    if ours is None:
        return False
    key_kinds = {}
    for _, kind in ours:
        key_kinds[kind] = key_kinds.get(kind, 0) + 1
    strings = [entry["NSStringLocalizedFormatKey"]]
    for name, variable in entry.items():
        if name != "NSStringLocalizedFormatKey" and isinstance(variable, dict):
            strings += [value for form, value in variable.items()
                        if not form.startswith("NSStringFormat") and isinstance(value, str)]
    for string in strings:
        theirs = specifiers(string)
        if theirs is None:
            return False
        kinds = {}
        for position, kind in theirs:
            kinds[kind] = kinds.get(kind, 0) + 1
            if position is not None and position > len(ours):
                return False
        if any(key_kinds.get(kind, 0) < number for kind, number in kinds.items()):
            return False
    return True


# MARK: - Tables


def parse_table(data):
    """A .strings (text, XML or binary) or .stringsdict file as a dictionary."""
    try:
        table = plistlib.loads(data)
    except Exception:
        # Old-style text .strings: plutil reads it.
        with tempfile.NamedTemporaryFile(suffix=".strings") as source:
            source.write(data)
            source.flush()
            xml = subprocess.run(["plutil", "-convert", "xml1", "-o", "-", source.name],
                                 capture_output=True, check=True).stdout
        table = plistlib.loads(xml)
    if not isinstance(table, dict):
        raise ValueError("not a table")
    return table


def checked(table, name):
    """`table` with the lines whose format doesn't fit their key dropped, and the dropped keys."""
    plural = name.endswith(".stringsdict")
    kept, dropped = {}, []
    for key, value in table.items():
        ok = fits_plural(value, key) if plural else isinstance(value, str) and fits(value, key)
        if ok:
            kept[key] = value
        else:
            dropped.append(key)
    return kept, sorted(dropped)


# MARK: - The app


class App:
    def __init__(self, path):
        self.path = path
        contents = os.path.join(path, "Contents")
        self.mac = os.path.isdir(contents)
        self.resources = os.path.join(contents, "Resources") if self.mac else path
        self.info_path = os.path.join(contents if self.mac else path, "Info.plist")
        with open(self.info_path, "rb") as handle:
            data = handle.read()
        self.info_format = plistlib.FMT_BINARY if data.startswith(b"bplist") else plistlib.FMT_XML
        self.info = plistlib.loads(data)

    @property
    def development(self):
        return self.info.get("CFBundleDevelopmentRegion") or "en"

    def own_languages(self):
        """Languages the app ships strings for itself: an .lproj with a table other than InfoPlist.strings (what a
        stub, or only the Info.plist's own texts, has)."""
        found = set()
        if not os.path.isdir(self.resources):
            return found
        for entry in os.listdir(self.resources):
            folder = os.path.join(self.resources, entry)
            if not entry.endswith(".lproj") or entry == "Base.lproj" or not os.path.isdir(folder):
                continue
            if any(name.endswith((".strings", ".stringsdict")) and name != "InfoPlist.strings"
                   for name in os.listdir(folder)):
                found.add(entry[: -len(".lproj")])
        return found

    def lproj(self, language):
        folder = os.path.join(self.resources, f"{language}.lproj")
        os.makedirs(folder, exist_ok=True)
        return folder

    def save_info(self):
        with open(self.info_path, "wb") as handle:
            plistlib.dump(self.info, handle, fmt=self.info_format, sort_keys=True)


def resolve_app(path):
    path = os.path.abspath(path)
    # xcodebuild adds .xcarchive to an -archivePath without it.
    if not path.endswith((".xcarchive", ".app")) and not os.path.exists(path):
        path += ".xcarchive"
    if path.endswith(".xcarchive"):
        applications = os.path.join(path, "Products", "Applications")
        apps = sorted(entry for entry in os.listdir(applications) if entry.endswith(".app")) \
            if os.path.isdir(applications) else []
        if len(apps) != 1:
            fail(f"expected one app in {applications}, found {len(apps)}")
        return os.path.join(applications, apps[0])
    return path


# MARK: - Signing


class Signature:
    """How the app was signed, read before it changes."""

    def __init__(self, app):
        self.app = app
        details = subprocess.run(["codesign", "-dvv", app], capture_output=True, text=True)
        self.signed = details.returncode == 0
        self.adhoc = "Signature=adhoc" in details.stderr
        self.timestamped = "\nTimestamp=" in details.stderr
        self.identity = None
        if self.signed and not self.adhoc:
            with tempfile.TemporaryDirectory() as folder:
                subprocess.run(["codesign", "-d", f"--extract-certificates={folder}/cert", app],
                               capture_output=True, check=True)
                with open(f"{folder}/cert0", "rb") as handle:
                    self.identity = hashlib.sha1(handle.read()).hexdigest().upper()

    def apply(self):
        if not self.signed:
            log("the app wasn't signed: left unsigned")
            return
        command = ["codesign", "--force", "--sign", self.identity or "-",
                   "--preserve-metadata=identifier,entitlements,requirements,flags,runtime",
                   "--timestamp" if self.timestamped else "--timestamp=none", self.app]
        result = subprocess.run(command, capture_output=True, text=True)
        if result.returncode != 0:
            fail(f"re-signing failed: {result.stderr.strip()}")
        verify = subprocess.run(["codesign", "--verify", "--strict", self.app], capture_output=True, text=True)
        if verify.returncode != 0:
            fail(f"the re-signed app doesn't verify: {verify.stderr.strip()}")


# MARK: - Main


def main():
    parser = argparse.ArgumentParser(description="Puts v57/Localizations' translations into a built app.")
    parser.add_argument("app", help="the .app, or an .xcarchive holding one")
    parser.add_argument("--sources", help="the app's sources, best first (KitLanguages.start(sources:))")
    parser.add_argument("--bundled", help="the languages the app ships with")
    parser.add_argument("--project-dir", default=os.getcwd(), help="where release.env is (default: here)")
    options = parser.parse_args()

    env = release_env(options.project_dir)
    sources = (options.sources or os.environ.get("V57_LANGUAGE_SOURCES") or env.get("LANGUAGE_SOURCES") or "").split()
    if not sources:
        log("no LANGUAGE_SOURCES (release.env or V57_LANGUAGE_SOURCES): the app keeps its own languages only")
        return
    bundled_wanted = (options.bundled or os.environ.get("V57_LANGUAGES_BUNDLED") or env.get("LANGUAGES_BUNDLED")
                      or DEFAULT_BUNDLED).split()

    app = App(resolve_app(options.app))
    signature = Signature(app.path)
    localizations = find_localizations(options.project_dir)
    log(f"v57/Localizations from {localizations.describe()}")
    try:
        manifest = json.loads(localizations.read("manifest.json"))
    except Exception as error:
        fail(f"can't read manifest.json: {error}")
    catalog = manifest.get("sources", {})
    missing = [source for source in sources if source not in catalog]
    if missing:
        log(f"no translations yet for {', '.join(missing)}")

    development = app.development
    translated = set()
    for source in sources:
        translated |= set(catalog.get(source, {}))
    translated.discard(development)
    # A language the app ships a table for itself is bundled too: the sources' lines go in behind the app's.
    bundled = sorted(language for language in translated
                     if language in bundled_wanted or language in app.own_languages())
    downloadable = sorted(translated - set(bundled))

    for language in bundled:
        folder = app.lproj(language)
        tables = {}  # file name -> merged table, first line wins
        for source in sources:
            for name, entry in sorted(catalog.get(source, {}).get(language, {}).items()):
                path = f"{source}/{language}.lproj/{name}"
                try:
                    data = localizations.read(path)
                except Exception as error:
                    fail(f"can't read {path}: {error}")
                if hashlib.sha256(data).hexdigest() != entry.get("sha256"):
                    fail(f"{path} doesn't match manifest.json (run Localizations' Scripts/build)")
                table, dropped = checked(parse_table(data), name)
                if dropped:
                    log(f"{path}: dropped {len(dropped)} line(s) whose format doesn't fit the key: "
                        + ", ".join(json.dumps(key) for key in dropped[:5]) + (" …" if len(dropped) > 5 else ""))
                if name not in tables:
                    own = os.path.join(folder, name)
                    tables[name] = parse_table(open(own, "rb").read()) if os.path.isfile(own) else {}
                merged = tables[name]
                for key, value in table.items():
                    merged.setdefault(key, value)
        for name, table in tables.items():
            with open(os.path.join(folder, name), "wb") as handle:
                plistlib.dump(table, handle, fmt=plistlib.FMT_BINARY, sort_keys=True)
        lines = sum(len(table) for table in tables.values())
        log(f"bundled {language}: {lines} lines in {', '.join(sorted(tables))}")

    # Stubs: the development language's InfoPlist.strings (so a stub changes nothing the app shows) or an empty one.
    own_info = os.path.join(app.resources, f"{development}.lproj", "InfoPlist.strings")
    stub = open(own_info, "rb").read() if os.path.isfile(own_info) else plistlib.dumps({}, fmt=plistlib.FMT_BINARY)
    sizes = {}
    for language in downloadable:
        folder = app.lproj(language)
        if not os.listdir(folder):
            with open(os.path.join(folder, "InfoPlist.strings"), "wb") as handle:
                handle.write(stub)
        sizes[language] = sum(file.get("bytes", 0) for source in sources
                              for file in catalog.get(source, {}).get(language, {}).values())

    localized = set(app.info.get("CFBundleLocalizations") or []) | {development} | set(bundled) | set(downloadable)
    app.info["CFBundleLocalizations"] = [development] + sorted(localized - {development})
    if sizes:
        app.info["V57Languages"] = sizes
    else:
        app.info.pop("V57Languages", None)
    app.save_info()
    total = sum(sizes.values())
    size = f"{total / 1024:.0f} KB" if total >= 1024 else f"{total} bytes"
    log(f"{len(downloadable)} downloadable language(s) ({size} in all) as stubs, "
        f"{len(app.info['CFBundleLocalizations'])} in CFBundleLocalizations")
    signature.apply()


if __name__ == "__main__":
    main()
