#!/bin/zsh
# The linker for release archives (ALTERNATE_LINKER_PATH), so dead stripping reaches into Swift packages.
#
# Xcode pre-links each Swift package target into one relocatable object (`ld -r`), and everything in such an
# object stays in the app, used or not: ComponentKit was 3 of Player's 4.6 MB. For those links this writes a
# static archive of the inputs instead, so the app's final link (LTO with `-internalize-at-link` and
# `-conditional-runtime-records`) can drop what nothing uses. Every other link goes to the real ld unchanged.
real_ld=$(xcrun -f ld)

if (( ${argv[(Ie)-r]} )); then
  out= deps= inputs=()
  for (( i = 1; i <= $#; i++ )); do
    case ${argv[i]} in
      -o) out=${argv[++i]} ;;
      -dependency_info) deps=${argv[++i]} ;;
      -filelist) inputs+=(${(f)"$(<${argv[++i]%%,*})"}) ;;
      -platform_version) (( i += 3 )) ;;
      -arch|-syslibroot|-L|-F|-object_path_lto|-map|-sectcreate|-exported_symbols_list) (( i++ )) ;;
      -*) ;;
      *.o|*.bc|*.a) inputs+=(${argv[i]}) ;;
    esac
  done
  [[ -n $out && ${#inputs} -gt 0 ]] || exec $real_ld "$@"
  rm -f $out
  xcrun libtool -static -no_warning_for_no_symbols -o $out $inputs || exit $?
  # Xcode reads ld's dependency info: a version record, then the inputs (0x10) and the output (0x40).
  if [[ -n $deps ]]; then
    { printf '\x00ld-archive-prelink\x00'; for f in $inputs; do printf '\x10%s\x00' $f; done; printf '\x40%s\x00' $out } > $deps
  fi
  exit 0
fi
# The final link. With LTO, LLVM's machine outliner moves instruction sequences repeated across functions into shared
# ones after optimisation (a quarter less code in every app, no measurable change in instructions run), and
# swift-record-gc (the Python below) relinks LTO's object so dead stripping also drops the Swift code that only Swift's
# own metadata records kept (SWIFT_RECORD_GC=0 turns it off). Every Objective-C class of the target's own objects
# stays, so the system can find a principal class by name (own_classes), and every class in the app is in its
# Objective-C class list, which LTO leaves out (register_classes).
(( ${argv[(Ie)-object_path_lto]} )) && set -- "$@" -mllvm -enable-machine-outliner=always -mllvm -machine-outliner-reruns=2
exec python3 -I <(sed '1,/^# --- python ---$/d' $0) $real_ld "$@"
# --- python ---
"""Relinks an LTO link's native object so ld drops the Swift code that only Swift's own records kept.

    swift-record-gc.py <real ld> <ld args…>   (a final link with -object_path_lto <obj> and -dead_strip; else plain ld)

After LTO every Swift runtime record left in the object is no_dead_strip, and so is every table of async entry points:
- conformance (__swift5_proto), type (__swift5_types), field (__swift5_fieldmd) and associated-type (__swift5_assocty)
  records, which LLVM kept because their type was used (-conditional-runtime-records);
- closure capture descriptors (__swift5_capture), which LLVM keeps always. One names the types its closure captures, so a
  view whose body has an escaping closure over `self` keeps its type, its conformances, witness tables and code;
- the per-file tables of async functions' entry, return and continuation points (__swift_as_entry/_ret/_cont, for the
  debugger), which keep every async function and closure in the file and what they use.
Most of an app's unused package code (ComponentKit's views) is held by these alone.

This dead-strips the LTO object again with LLVM's rule instead: a capture descriptor stays while the closure metadata
pointing at it does (the runtime never looks one up by section), a table entry while its function does (each entry
becomes its own live_support atom), and a record while its type (and protocol) is in the output. Starting with no
records it links, adds the records whose conditions are live, and relinks until nothing changes. The code that stays is
the LTO output byte for byte; only atoms nothing reaches go. Any surprise in the object leaves the link as LTO made it.

Then, with or without that, it relinks with an __objc_classlist entry for each class LTO kept without one (see
register_classes): the Objective-C runtime aborts on such a class as soon as KVO or a method lookup touches it.

SWIFT_RECORD_GC=0 turns the record pass off; SWIFT_RECORD_GC_LOG=1 prints the rounds.
"""
import os, shutil, struct, subprocess, sys, tempfile

N_NO_DEAD_STRIP, N_ALT_ENTRY = 0x20, 0x200
N_SECT = 0x0e
S_ATTR_NO_DEAD_STRIP, S_ATTR_LIVE_SUPPORT = 0x10000000, 0x08000000
RECORDS = {b'__swift5_proto', b'__swift5_types', b'__swift5_fieldmd', b'__swift5_assocty', b'__swift5_capture'}
ASYNC = {b'__swift_as_entry', b'__swift_as_ret', b'__swift_as_cont'}
SUBTRACTOR, UNSIGNED = 1, 0
# Protocols whose conforming types the system looks up by name, from metadata, with no reference in code.
FOUND_BY_NAME = ('10AppIntents', '9WidgetKit', '19ExtensionFoundation', '12ExtensionKit')


def log(*a):
    if os.environ.get('SWIFT_RECORD_GC_LOG'):
        print('swift-record-gc:', *a, file=sys.stderr)


class Obj:
    """A 64-bit Mach-O object: sections, symbols and relocations."""

    def __init__(self, data):
        self.data = d = data
        magic, _, _, ftype, ncmds = struct.unpack_from('<IiiII', d, 0)
        if magic != 0xfeedfacf or ftype != 1:
            raise ValueError('not a 64-bit Mach-O object')
        self.sections = []  # (segname, sectname, addr, size, file offset, reloff, nreloc, flags, header offset)
        self.symtab_cmd = self.dysymtab_cmd = None
        off = 32
        for _ in range(ncmds):
            cmd, size = struct.unpack_from('<II', d, off)
            if cmd == 0x19:
                nsects = struct.unpack_from('<I', d, off + 64)[0]
                s = off + 72
                for _ in range(nsects):
                    sect, seg = bytes(d[s:s + 16].rstrip(b'\0')), bytes(d[s + 16:s + 32].rstrip(b'\0'))
                    addr, ssize, foff, _, reloff, nreloc, flags = struct.unpack_from('<QQIIIII', d, s + 32)
                    self.sections.append((seg, sect, addr, ssize, foff, reloff, nreloc, flags, s))
                    s += 80
            elif cmd == 0x2:
                self.symtab_cmd = off
            elif cmd == 0xb:
                self.dysymtab_cmd = off
            off += size
        if self.symtab_cmd is None or self.dysymtab_cmd is None:
            raise ValueError('no symbol table')
        self.symoff, self.nsyms, self.stroff, self.strsize = struct.unpack_from('<IIII', d, self.symtab_cmd + 8)
        self.syms = []  # (name, n_type, n_sect, n_desc, value)
        for i in range(self.nsyms):
            strx, ntype, nsect, ndesc, value = struct.unpack_from('<IBBHQ', d, self.symoff + 16 * i)
            end = d.index(b'\0', self.stroff + strx)
            self.syms.append((bytes(d[self.stroff + strx:end]).decode('utf-8', 'replace'), ntype, nsect, ndesc, value))
        self.defined = {}  # name → (sect index 1-based, value)
        self.by_sect = {}  # sect index → sorted [(value, symbol index)]
        for i, (name, ntype, nsect, ndesc, value) in enumerate(self.syms):
            if ntype & 0xe0 == 0 and ntype & 0x0e == 0x0e and nsect:  # N_SECT, not a stab
                self.defined.setdefault(name, (nsect, value))
                self.by_sect.setdefault(nsect, []).append((value, i))
        for v in self.by_sect.values():
            v.sort()
        self._targets = {}

    def relocs(self, n):  # section index (1-based) → [(address, type, extern, symnum, file offset of the entry)]
        _, _, _, _, _, reloff, nreloc, _, _ = self.sections[n - 1]
        out = []
        for k in range(nreloc):
            addr, info = struct.unpack_from('<iI', self.data, reloff + 8 * k)
            out.append((addr, info >> 28, (info >> 27) & 1, info & 0xffffff, reloff + 8 * k))
        return out

    def targets(self, n):  # section index → {address: target symbol name or None}
        if n not in self._targets:
            self._targets[n] = {a: self.syms[s][0] if ext else None
                                for a, t, ext, s, _ in self.relocs(n) if t not in (SUBTRACTOR, 10)}  # 10: ADDEND
        return self._targets[n]

    def target(self, name, offset):
        """The symbol a pointer at `offset` in symbol `name` points at: a name, or None if unknown."""
        if name not in self.defined:
            return None
        n, value = self.defined[name]
        return self.targets(n).get(value - self.sections[n - 1][2] + offset)


def split_async_tables(o):
    """A copy of the object whose async tables are live_support atoms of one entry each, or None if they look unusual.

    An entry is `.long function - .`: a SUBTRACTOR of the table's symbol (its addend, the entry's offset in the table,
    negated, in the section data) paired with an UNSIGNED of the function. Each entry gets its own local symbol, the
    SUBTRACTOR names it and the addend becomes 0."""
    d = bytearray(o.data)
    ilocal, nlocal, iext, next_, iundef, nundef = struct.unpack_from('<6I', d, o.dysymtab_cmd + 8)
    if ilocal != 0 or iext != nlocal or iundef != iext + next_ or iundef + nundef != o.nsyms:
        return None
    new_syms, new_names, patches = [], [], []  # patches: (reloc entry offset, new symbol number, data offset)
    sects = [n for n, s in enumerate(o.sections, 1) if s[1] in ASYNC and s[0] == b'__TEXT']
    for n in sects:
        seg, sect, addr, size, foff, _, _, flags, hdr = o.sections[n - 1]
        if flags & 0xff != 0x0b or size % 4:
            return None
        relocs = o.relocs(n)
        subs = {a: (s, e) for a, t, ext, s, e in relocs if t == SUBTRACTOR and ext}
        uns = {a for a, t, ext, s, e in relocs if t == UNSIGNED and ext}
        if len(relocs) != 2 * len(subs) or set(subs) != uns or 4 * len(subs) != size:
            return None
        for a, (s, e) in subs.items():
            if a % 4 or s >= nlocal:
                return None
            table = o.syms[s][4] - addr  # the table's offset in the section
            if struct.unpack_from('<i', d, foff + a)[0] != table - a:
                return None
            if a == table:
                continue
            new_syms.append((n, addr + a))
            new_names.append(('l__swift_as.%d' % len(new_names)).encode())
            patches.append((e, nlocal + len(new_syms) - 1, foff + a))
    if not sects:
        return None
    count = len(new_syms)
    # The symbol table with the new locals after the old ones, and the string table after it, at the end of the file.
    strtab = bytearray(d[o.stroff:o.stroff + o.strsize])
    symtab = bytearray(d[o.symoff:o.symoff + 16 * nlocal])
    for (n, value), name in zip(new_syms, new_names):
        symtab += struct.pack('<IBBHQ', len(strtab), 0x0e, n, 0, value)
        strtab += name + b'\0'
    symtab += d[o.symoff + 16 * nlocal:o.symoff + 16 * o.nsyms]
    for i in range(nlocal):  # the tables' own symbols lose no_dead_strip
        _, ntype, nsect, ndesc, _ = o.syms[i]
        if nsect in sects and ndesc & N_NO_DEAD_STRIP:
            struct.pack_into('<H', symtab, 16 * i + 6, ndesc & ~N_NO_DEAD_STRIP)
    for n, s in enumerate(o.sections, 1):  # extern symbol numbers move up by `count`
        for a, t, ext, sym, e in o.relocs(n):
            if ext and sym >= nlocal:
                info = struct.unpack_from('<I', d, e + 4)[0]
                struct.pack_into('<I', d, e + 4, (info & ~0xffffff) | (sym + count))
    for e, sym, data in patches:
        info = struct.unpack_from('<I', d, e + 4)[0]
        struct.pack_into('<I', d, e + 4, (info & ~0xffffff) | sym)
        struct.pack_into('<i', d, data, 0)
    for n in sects:
        hdr = o.sections[n - 1][8]
        flags = struct.unpack_from('<I', d, hdr + 64)[0]
        struct.pack_into('<I', d, hdr + 64, (flags & ~S_ATTR_NO_DEAD_STRIP) | S_ATTR_LIVE_SUPPORT)
    while len(d) % 8:
        d.append(0)
    symoff = len(d)
    d += symtab
    stroff = len(d)
    d += strtab
    struct.pack_into('<IIII', d, o.symtab_cmd + 8, symoff, o.nsyms + count, stroff, len(strtab))
    struct.pack_into('<6I', d, o.dysymtab_cmd + 8, 0, nlocal + count, nlocal + count, next_, iundef + count, nundef)
    log('async tables: %d entries in their own atoms' % (count + len(sects)))
    return d


def conditions(o, name, sect):
    """Symbols that must all be live to keep a record ('never': only what points at it keeps it; None: keep always)."""
    def local(targets):  # an external target is always there
        out = set()
        for t in targets:
            if t.startswith('l_got.'):  # a pointer to the descriptor: what counts is the descriptor itself
                t = o.target(t, 0) or t
            if t in o.defined:
                out.add(t)
        return out
    def conformance(mc):
        if mc is None or mc not in o.defined:
            return None
        proto, typ = o.target(mc, 0), o.target(mc, 4)
        if typ is None:  # can't tell: keep
            return None
        if proto and proto.startswith('l_got.'):
            proto = o.target(proto, 0) or proto
        if proto and any(m in proto for m in FOUND_BY_NAME):  # the system finds these types by name: keep
            return None
        return local([typ] + ([proto] if proto else []))
    if sect == b'__swift5_capture':
        return 'never'
    if sect == b'__swift5_proto':
        return conformance(o.target(name, 0))
    if sect == b'__swift5_types':
        t = o.target(name, 0)
        return None if t is None else local([t])
    if sect == b'__swift5_fieldmd' and name.endswith('MF'):
        mn = name[:-2] + 'Mn'
        return {mn} if mn in o.defined else None
    if sect == b'__swift5_assocty' and name.endswith('MA'):
        return conformance(name[:-2] + 'Mc')
    return None


def live_symbols(map_path):
    live = set()
    with open(map_path, errors='replace') as f:
        on = False
        for line in f:
            if line.startswith('# Symbols:'):
                on = True
            elif line.startswith('# Dead Stripped Symbols:'):
                break
            elif on and line.startswith('0x'):
                i = line.find('] ')
                if i > 0:
                    live.add(line[i + 2:].rstrip('\n'))
    return live


def is_bitcode(path):
    try:
        with open(path, 'rb') as f:
            return f.read(4) in (b'BC\xc0\xde', b'\xde\xc0\x17\x0b')
    except OSError:
        return False


def native_archive(path, tmp):
    """The archive without its bitcode members (None if none are left), or the input itself if it has no bitcode."""
    try:
        with open(path, 'rb') as f:
            if f.read(8) != b'!<arch>\n':
                return path
    except OSError:
        return path
    d = tempfile.mkdtemp(dir=tmp)
    subprocess.run(['ar', 'x', os.path.abspath(path)], cwd=d, check=True)
    members = [m for m in sorted(os.listdir(d)) if not m.startswith('__.SYMDEF')]
    native = [m for m in members if not is_bitcode(os.path.join(d, m))]
    if len(native) == len(members):
        return path
    if not native:
        return None
    out = os.path.join(d, os.path.basename(path) + '.a')
    subprocess.run(['xcrun', 'libtool', '-static', '-no_warning_for_no_symbols', '-o', out]
                   + [os.path.join(d, m) for m in native], check=True)
    return out


def native_link(args, lto, tmp):
    """The link's arguments with the LTO object in place of the bitcode inputs."""
    out, i = [], 0
    while i < len(args):
        a = args[i]
        if a in ('-object_path_lto', '-dependency_info', '-map'):
            i += 2
            continue
        if a == '-filelist':
            path, _, base = args[i + 1].partition(',')
            files = []
            for f in open(path).read().splitlines():
                full = os.path.join(base, f) if base else f
                if not is_bitcode(full):
                    nat = native_archive(full, tmp)
                    if nat:
                        files.append(nat)
            lst = os.path.join(tmp, 'inputs-%d.LinkFileList' % i)
            open(lst, 'w').write('\n'.join(files) + '\n')
            out += ['-filelist', lst]
            i += 2
            continue
        if (not a.startswith('-') and a.endswith(('.o', '.a', '.bc'))
                and args[i - 1] not in ('-o', '-final_output', '-object_path_lto')):
            if not is_bitcode(a):
                nat = native_archive(a, tmp)
                if nat:
                    out.append(nat)
            i += 1
            continue
        out.append(a)
        i += 1
    return out + [lto]


def gc(ld, args, lto, tmp):
    """The symbols live in the last relink (the output), or None if a relink failed."""
    o = Obj(bytearray(open(lto, 'rb').read()))
    split = split_async_tables(o)
    if split is not None:
        o = Obj(split)
    else:
        log('async tables left as they are')
    sect_names = {n: s[1] for n, s in enumerate(o.sections, 1)}
    records = []  # (symbol index, conditions)
    for i, (name, ntype, nsect, ndesc, _) in enumerate(o.syms):
        if ndesc & N_NO_DEAD_STRIP and ntype & 0xe0 == 0 and nsect and sect_names[nsect] in RECORDS:
            records.append((i, conditions(o, name, sect_names[nsect])))
    alias = {}  # symbols at the same place are live together
    for lst in o.by_sect.values():
        for (v, a), (w, b) in zip(lst, lst[1:]):
            if v == w:
                alias.setdefault(o.syms[a][0], set()).add(o.syms[b][0])
                alias.setdefault(o.syms[b][0], set()).add(o.syms[a][0])
    mapfile = os.path.join(tmp, 'link.map')
    relink = native_link(args, lto, tmp) + ['-map', mapfile]
    keep = {i for i, c in records if c is None}
    rounds = 0
    while True:
        rounds += 1
        for i, c in records:
            off = o.symoff + 16 * i + 6
            desc = struct.unpack_from('<H', o.data, off)[0]
            struct.pack_into('<H', o.data, off, desc | N_NO_DEAD_STRIP if i in keep else desc & ~N_NO_DEAD_STRIP)
        open(lto, 'wb').write(o.data)
        if subprocess.run([ld] + relink).returncode:
            return None
        live = live_symbols(mapfile)
        for s in list(live):
            live |= alias.get(s, set())
        new = {i for i, c in records if c is None or (c != 'never' and c <= live)}
        log('round %d: %d of %d records kept' % (rounds, len(new), len(records)))
        if new <= keep or rounds == int(os.environ.get('SWIFT_RECORD_GC_ROUNDS', '0')):
            return live
        keep |= new


def class_objects(o):
    """Each class with static metadata in the object: its full metadata symbol → (section index, class object address).

    A Swift class's full metadata (…CMf) holds its class object a few words in, which starts with its isa: a pointer to
    its metaclass, an Objective-C one or Swift's own (…CMm)."""
    out = {}
    for name, (n, value) in o.defined.items():
        if name.endswith('CMf') and o.sections[n - 1][0].startswith(b'__DATA'):
            for off in range(0, 64, 8):
                t = o.target(name, off)
                if t and (t.startswith('_OBJC_METACLASS_$_') or t.endswith('CMm')):
                    out[name] = (n, value + off)
                    break
    return out


def class_list(o):
    """The (section index, address) of each class the object's __objc_classlist entries point at."""
    out = set()
    for n, s in enumerate(o.sections, 1):
        if s[1] == b'__objc_classlist':
            for a, t, ext, sym, _ in o.relocs(n):
                if ext and t == UNSIGNED and o.syms[sym][0] in o.defined:
                    tn, tv = o.defined[o.syms[sym][0]]
                    out.add((tn, tv + struct.unpack_from('<q', o.data, s[4] + a)[0]))
    return out


def with_class_list(o, new):
    """A copy of the object with a local alternate entry (N_ALT_ENTRY) for each of `new`, (name, section index,
    address), and an __objc_classlist section at the end pointing at them, as LLVM writes a class's own entry. The
    entries must be in this object: ld reads a class list entry's class from the entry's own file."""
    d = bytearray(o.data)
    f = list(struct.unpack_from('<18I', d, o.dysymtab_cmd + 8))
    ilocal, nlocal, iext, next_, iundef, nundef = f[:6]
    if (ilocal != 0 or iext != nlocal or iundef != iext + next_ or iundef + nundef != o.nsyms
            or any(f[6:12]) or any(f[14:])):
        raise ValueError('unusual symbol table')
    count = len(new)
    # The new locals go after the old ones; the external and undefined symbols move up by `count`.
    strtab = bytearray(d[o.stroff:o.stroff + o.strsize])
    symtab = bytearray(d[o.symoff:o.symoff + 16 * nlocal])
    for name, n, addr in new:
        symtab += struct.pack('<IBBHQ', len(strtab), N_SECT, n, N_ALT_ENTRY, addr)
        strtab += name.encode() + b'\0'
    symtab += d[o.symoff + 16 * nlocal:o.symoff + 16 * o.nsyms]
    for n in range(1, len(o.sections) + 1):
        for a, t, ext, sym, e in o.relocs(n):
            if ext and sym >= nlocal:
                info = struct.unpack_from('<I', d, e + 4)[0]
                struct.pack_into('<I', d, e + 4, (info & ~0xffffff) | (sym + count))
    for k in range(f[13]):  # indirect symbols, other than INDIRECT_SYMBOL_LOCAL and _ABS
        v = struct.unpack_from('<I', d, f[12] + 4 * k)[0]
        if not v & 0xc0000000 and v >= nlocal:
            struct.pack_into('<I', d, f[12] + 4 * k, v + count)
    while len(d) % 8:
        d.append(0)
    symoff = len(d)
    d += symtab
    stroff = len(d)
    d += strtab
    struct.pack_into('<IIII', d, o.symtab_cmd + 8, symoff, o.nsyms + count, stroff, len(strtab))
    struct.pack_into('<6I', d, o.dysymtab_cmd + 8, 0, nlocal + count, nlocal + count, next_, iundef + count, nundef)
    # An 8-byte pointer to each new symbol.
    relocs = b''.join(struct.pack('<iI', 8 * k, (nlocal + k) | 3 << 25 | 1 << 27 | UNSIGNED << 28)
                      for k in range(count))
    return with_section(d, b'__objc_classlist', bytes(8 * count), relocs, S_ATTR_NO_DEAD_STRIP, 3)


def load_commands(d):
    """The object's load commands, (cmd, offset), if they're all ones shifted() knows."""
    ncmds, off, out = struct.unpack_from('<I', d, 16)[0], 32, []
    for _ in range(ncmds):
        cmd, size = struct.unpack_from('<II', d, off)
        if cmd not in (0x2, 0xb, 0x19, 0x24, 0x25, 0x26, 0x29, 0x2d, 0x2e, 0x2f, 0x30, 0x32):
            raise ValueError('load command 0x%x' % cmd)
        out.append((cmd, off))
        off += size
    return out


def shifted(d, pos, n):
    """A copy of the object with n zero bytes inserted at file offset `pos` (after the load commands), the load
    commands' file offsets moved to match."""
    out = bytearray(d[:pos]) + bytes(n) + d[pos:]
    def move(at, fmt='<I'):  # 0: nothing there
        v = struct.unpack_from(fmt, out, at)[0]
        if v and v >= pos:
            struct.pack_into(fmt, out, at, v + n)
    for cmd, off in load_commands(out):
        if cmd == 0x19:
            fileoff, filesize = struct.unpack_from('<QQ', out, off + 40)
            if fileoff < pos < fileoff + filesize:
                struct.pack_into('<Q', out, off + 48, filesize + n)
            move(off + 40, '<Q')
            for h in range(off + 72, off + 72 + 80 * struct.unpack_from('<I', out, off + 64)[0], 80):
                if struct.unpack_from('<I', out, h + 64)[0] & 0xff not in (0x1, 0xc, 0x12):  # zerofill: no contents
                    move(h + 48)
                move(h + 56)
        elif cmd == 0x2:
            move(off + 8)
            move(off + 16)
        elif cmd == 0xb:
            for field in (32, 40, 48, 56, 64, 72):
                move(off + field)
        elif cmd in (0x26, 0x29, 0x2e):  # linkedit data: dataoff
            move(off + 8)
    return out


def with_section(d, name, contents, relocs, flags, align):
    """A copy of the object with a __DATA section added after its segment's last one, laid out as LLVM does: its
    header after the others (everything after the load commands moves by a multiple of every section's alignment), its
    contents after the segment's, its relocations after the other sections'."""
    cmds = load_commands(d)
    segs = [off for cmd, off in cmds if cmd == 0x19]
    if len(segs) != 1:
        raise ValueError('%d segments' % len(segs))
    seg = segs[0]
    cmdsize, nsects = struct.unpack_from('<I', d, seg + 4)[0], struct.unpack_from('<I', d, seg + 64)[0]
    headers = range(seg + 72, seg + 72 + 80 * nsects, 80)
    step = max([8] + [1 << struct.unpack_from('<I', d, h + 52)[0] for h in headers])
    sizeofcmds = struct.unpack_from('<I', d, 20)[0]
    end, at = 32 + sizeofcmds, seg + cmdsize
    d = shifted(d, end, (80 + step - 1) // step * step)
    d[:end + 80] = d[:at] + bytes(80) + d[at:end]  # the header, filled in below
    struct.pack_into('<I', d, seg + 4, cmdsize + 80)
    struct.pack_into('<I', d, seg + 64, nsects + 1)
    struct.pack_into('<I', d, 20, sizeofcmds + 80)
    vmaddr, vmsize, fileoff, filesize = struct.unpack_from('<QQQQ', d, seg + 24)
    pos = fileoff + filesize
    pad = -pos % 8
    size = (pad + len(contents) + 7) // 8 * 8
    d = shifted(d, pos, size)
    sectoff = pos + pad
    d[sectoff:sectoff + len(contents)] = contents
    ends = [struct.unpack_from('<I', d, h + 56)[0] + 8 * struct.unpack_from('<I', d, h + 60)[0] for h in headers
            if struct.unpack_from('<I', d, h + 60)[0]]
    reloff = max(ends) if ends else pos + size
    d = shifted(d, reloff, len(relocs))
    d[reloff:reloff + len(relocs)] = relocs
    addr = (vmaddr + vmsize + (1 << align) - 1) & ~((1 << align) - 1)
    d[at:at + 80] = struct.pack('<16s16sQQIIIIIIII', name, b'__DATA', addr, len(contents), sectoff, align, reloff,
                                len(relocs) // 8, flags, 0, 0, 0)
    struct.pack_into('<QQQQ', d, seg + 24, vmaddr, addr + len(contents) - vmaddr, fileoff, filesize + size)
    return d


def register_classes(ld, args, lto, tmp, live):
    """Relinks with an Objective-C class list entry for each class in the output that LTO left without one.

    -conditional-runtime-records makes a Swift class's __objc_classlist entry conditional on the class's …CN symbol,
    an alias into its metadata that code doesn't use (it calls the metadata accessor), so LTO drops nearly every entry
    while the class stays. The runtime never registers such a class, and the first KVO observer or method lookup on it
    aborts ("no class for metaclass"): AppKit observing an NSTextView subclass in a scroll view crashed Markdown on
    opening any file. The LTO object gets the missing entries (with_class_list). `live`: the output's symbols, or None
    to find them with a native link."""
    o = Obj(bytearray(open(lto, 'rb').read()))
    relink = native_link(args, lto, tmp)
    if live is None:
        mapfile = os.path.join(tmp, 'classes.map')
        if subprocess.run([ld] + relink + ['-map', mapfile]).returncode:
            return False
        live = live_symbols(mapfile)
    listed = class_list(o)
    new = []
    for name, (n, addr) in sorted(class_objects(o).items()):
        if name in live and (n, addr) not in listed:
            sym = name[:-2] + 'N'
            new.append((sym + '.classlist' if sym in o.defined else sym, n, addr))
    log('%d classes in the class list, %d added: %s' % (len(listed), len(new), ' '.join(s for s, _, _ in new)))
    if not new:
        return True
    open(lto, 'wb').write(with_class_list(o, new))
    return subprocess.run([ld] + relink).returncode == 0


def own_classes(args):
    """-u for each Objective-C class the target's own objects define.

    -conditional-runtime-records keeps a class's Objective-C record only while code uses the class, so dead stripping
    drops a class the system finds by name alone (an extension's NSExtensionPrincipalClass, NSPrincipalClass, a
    storyboard's class) and NSClassFromString returns nil: the extension fails to load. The target's own objects are
    its bitcode or Mach-O files; the packages' pre-links come as archives (some universal), and their classes still go.
    """
    files = []
    for i, a in enumerate(args[:-1]):
        if a == '-filelist':
            path, _, base = args[i + 1].partition(',')
            for f in open(path).read().splitlines():
                full = os.path.join(base, f) if base else f
                try:
                    with open(full, 'rb') as h:
                        if h.read(4) in (b'BC\xc0\xde', b'\xde\xc0\x17\x0b', b'\xcf\xfa\xed\xfe'):
                            files.append(full)
                except OSError:
                    pass
    if not files:
        return []
    r = subprocess.run(['xcrun', 'nm', '-U', '-j', '--'] + files, capture_output=True, text=True)
    classes = sorted({line for line in r.stdout.splitlines() if line.startswith('_OBJC_CLASS_$_')})
    log('keeping %d Objective-C classes of the target: %s' % (len(classes), ' '.join(classes)))
    return [arg for c in classes for arg in ('-u', c)]


def main():
    ld, args = sys.argv[1], sys.argv[2:]
    if '-r' not in args and '-dead_strip' in args:
        args += own_classes(args)
    if '-r' in args or '-dead_strip' not in args or '-object_path_lto' not in args:
        os.execv(ld, [ld] + args)
    lto = args[len(args) - 1 - args[::-1].index('-object_path_lto') + 1]  # the last one counts
    rc = subprocess.run([ld] + args).returncode
    if rc or not os.path.isfile(lto):
        sys.exit(rc)
    with tempfile.TemporaryDirectory(prefix='swift-record-gc.') as tmp:
        live = None
        if os.environ.get('SWIFT_RECORD_GC') != '0':
            original = os.path.join(tmp, 'lto.o')
            shutil.copy2(lto, original)
            try:
                live = gc(ld, args, lto, tmp)
            except Exception as e:  # noqa: BLE001 — anything unexpected: keep LTO's own link
                log('failed: %r' % e)
            if live is None:
                print('swift-record-gc: relink failed; linking as LTO did', file=sys.stderr)
                shutil.copy2(original, lto)
                rc = subprocess.run([ld] + args).returncode
                if rc:
                    sys.exit(rc)
        # No way around this one: without the class list entries the app crashes, so a failure fails the link.
        try:
            ok = register_classes(ld, args, lto, tmp, live)
        except Exception as e:  # noqa: BLE001
            print('swift-record-gc: registering the Objective-C classes failed: %r' % e, file=sys.stderr)
            ok = False
        if not ok:
            print('swift-record-gc: the classes LTO left out of the Objective-C class list could not be added',
                  file=sys.stderr)
            sys.exit(1)
    sys.exit(0)


main()
