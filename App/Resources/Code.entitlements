<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- The v57 vault (../Vault): the projects Git and the other apps share, in the app group container,
	     sealed with keys from the shared keychain group. Code only reads them, so it doesn't sync. -->
	<key>com.apple.security.application-groups</key>
	<array>
		<string>$(TeamIdentifierPrefix)dev.v57</string>
	</array>
	<key>keychain-access-groups</key>
	<array>
		<string>$(AppIdentifierPrefix)dev.v57.shared</string>
	</array>
</dict>
</plist>
